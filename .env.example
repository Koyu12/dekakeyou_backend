PORT=4000
# host port for the docker-compose database (change it, and the URLs below, if 5432 is taken)
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dekakeyou
# e2e tests use their own database (created and migrated by the e2e setup)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dekakeyou_test

# Better Auth. BETTER_AUTH_URL is the public site URL (the frontend), which proxies /api/* to this API.
BETTER_AUTH_URL=http://localhost:3000
# generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# optional: Google login is enabled only when both are set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# optional: AI text moderation (OpenAI moderation API). Without it, only the banned-word list runs.
OPENAI_API_KEY=
