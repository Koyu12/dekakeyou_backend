PORT=4000
# host port for the docker-compose database (change it, and the URLs below, if 5432 is taken)
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dekakeyou
# e2e tests use their own database (created and migrated by the e2e setup)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dekakeyou_test

# Better Auth. BETTER_AUTH_URL is the public site URL (the frontend), which proxies /api/* to this API.
BETTER_AUTH_URL=http://localhost:3000
# generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# optional: Google login is enabled only when both are set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# optional: AI text moderation (OpenAI moderation API). Without it, only the banned-word list runs.
OPENAI_API_KEY=

# optional: send email over SMTP. Leave SMTP_HOST empty to print emails (and login codes) to the log.
# A partial config stops the app at startup. Any SMTP provider works (Gmail app password, Brevo, Resend, SES).
# Local catcher: `docker compose --profile mail up -d mailpit`, then SMTP_HOST=localhost, SMTP_PORT=1025,
# no user/password, and read mail at http://localhost:8025
SMTP_HOST=
# e.g. SMTP_PORT=587, SMTP_FROM=Dekakeyou <no-reply@your-domain>
SMTP_PORT=
# true = TLS from the start (port 465); false = STARTTLS (587). Defaults to true only on 465.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# optional: Cover Image uploads to an S3-compatible store (Supabase Storage; see README).
# Leave all empty and uploads answer 503. A partial config stops the app at startup.
# Supabase: Project Settings → Storage → S3 Connection gives the endpoint, region and keys.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=
